@using CAS.DTOs.Advisory
@model AdvisoryDetailsResponseModel

@{
    ViewData["Title"] = "Advisory Details";
    Layout = "_FarmerLayout";
}

<div class="container-fluid py-4">

    <div class="mb-4 d-flex justify-content-between align-items-center">

        <div>
            <h2 class="fw-bold mb-1">🌱 Farming Advisory</h2>
            <p class="text-muted mb-0">
                Complete farming recommendation for this crop.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-success">

            <i class="lni lni-arrow-left"></i>

            Back to Advisories

        </a>

    </div>

    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-4">

            <div class="row mb-4">

                <div class="col-lg-3 mb-3">

                    <label class="text-muted small">
                        Crop
                    </label>

                    <h5 class="fw-bold">
                        @Model.Crop
                    </h5>

                </div>

                <div class="col-lg-3 mb-3">

                    <label class="text-muted small">
                        Season
                    </label>

                    <h5>

                        <span class="badge bg-primary">

                            @Model.Season

                        </span>

                    </h5>

                </div>

                <div class="col-lg-3 mb-3">

                    <label class="text-muted small">
                        Soil Type
                    </label>

                    <h5>

                        <span class="badge bg-warning text-dark">

                            @Model.SoilType

                        </span>

                    </h5>

                </div>

                <div class="col-lg-3 mb-3">

                    <label class="text-muted small">
                        Location
                    </label>

                    <h5>

                        <i class="lni lni-map-marker"></i>

                        @Model.Location

                    </h5>

                </div>

            </div>

            <hr />

            <h3 class="fw-bold text-success mb-3">

                @Model.Title

            </h3>

            <div class="row mt-4">

                <div class="col-lg-6 mb-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-header bg-primary text-white">

                            💧 Watering Advice

                        </div>

                        <div class="card-body">

                            @Model.WateringAdvice

                        </div>

                    </div>

                </div>

                <div class="col-lg-6 mb-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-header bg-success text-white">

                            🌿 Fertilizer Advice

                        </div>

                        <div class="card-body">

                            @Model.FertilizerAdvice

                        </div>

                    </div>

                </div>

                <div class="col-lg-6 mb-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-header bg-danger text-white">

                            🐛 Pest Control Advice

                        </div>

                        <div class="card-body">

                            @Model.PestControlAdvice

                        </div>

                    </div>

                </div>

                <div class="col-lg-6 mb-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="card-header bg-warning text-dark">

                            🌾 Harvesting Tips

                        </div>

                        <div class="card-body">

                            @Model.HarvestingTips

                        </div>

                    </div>

                </div>

            </div>

            <hr />

            <div class="text-end">

                <small class="text-muted">

                    <i class="lni lni-calendar"></i>

                    Created:
                    @Model.CreatedAt.ToString("dd MMMM yyyy")

                </small>

            </div>

        </div>

    </div>

</div>