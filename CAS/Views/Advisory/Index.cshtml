@using CAS.DTOs.Advisory
@model PagedResponse<AdvisoryCardResponseModel>

@{
    ViewData["Title"] = "Farming Advisories";
    Layout = "_FarmerLayout";
}

<div class="container-fluid py-4">

    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">

                <div>
                    <h3 class="fw-bold mb-1">
                        🌱 Farming Advisory Center
                    </h3>

                    <p class="text-muted mb-0">
                        Search and discover farming recommendations based on crop, season and soil type.
                    </p>
                </div>

            </div>

            <form method="get">

                <div class="row g-3">

                    <div class="col-lg-4">

                        <input type="text"
                               name="Keyword"
                               value="@Context.Request.Query["Keyword"]"
                               class="form-control"
                               placeholder="Search crop, title or recommendation..." />

                    </div>

                    <div class="col-lg-2">

                        <select name="CropId" class="form-select">

                            <option value="">All Crops</option>

                            @foreach (var crop in ViewBag.Crops)
                            {
                                <option value="@crop.Id">
                                    @crop.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-2">

                        <select name="SeasonId" class="form-select">

                            <option value="">All Seasons</option>

                            @foreach (var season in ViewBag.Seasons)
                            {
                                <option value="@season.Id">
                                    @season.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-2">

                        <select name="SoilTypeId" class="form-select">

                            <option value="">All Soil Types</option>

                            @foreach (var soil in ViewBag.SoilTypes)
                            {
                                <option value="@soil.Id">
                                    @soil.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-lg-2">

                        <input type="text"
                               name="Location"
                               value="@Context.Request.Query["Location"]"
                               class="form-control"
                               placeholder="Location" />

                    </div>

                    <div class="col-12 d-flex gap-2">

                        <button class="btn btn-success">

                            <i class="lni lni-search-alt"></i>

                            Search

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Clear

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="fw-bold">

            @(Model.TotalRecords) Advisory@(Model.TotalRecords == 1 ? "" : "ies") Found

        </h5>

    </div>

    @if (Model.Data.Any())
    {
        <div class="row">

            @foreach (var advisory in Model.Data)
            {
                <div class="col-xl-4 col-lg-6 mb-4">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-body">

                            <div class="mb-3">

                                <span class="badge bg-success me-1">
                                    @advisory.Crop
                                </span>

                                <span class="badge bg-primary me-1">
                                    @advisory.Season
                                </span>

                                <span class="badge bg-warning text-dark">
                                    @advisory.SoilType
                                </span>

                            </div>

                            <h5 class="fw-bold mb-2">

                                @advisory.Title

                            </h5>

                            <p class="text-muted">

                                <i class="lni lni-map-marker"></i>

                                @advisory.Location

                            </p>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <a asp-action="Details"
                               asp-route-id="@advisory.Id"
                               class="btn btn-success w-100">

                                <i class="lni lni-eye"></i>

                                View Full Advisory

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>

                <ul class="pagination justify-content-center">

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-Page="@i"
                               asp-route-Keyword="@Context.Request.Query["Keyword"]"
                               asp-route-CropId="@Context.Request.Query["CropId"]"
                               asp-route-SeasonId="@Context.Request.Query["SeasonId"]"
                               asp-route-SoilTypeId="@Context.Request.Query["SoilTypeId"]"
                               asp-route-Location="@Context.Request.Query["Location"]">

                                @i

                            </a>

                        </li>
                    }

                </ul>

            </nav>
        }
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body text-center py-5">

                <img src="~/assets/images/empty.svg"
                     width="180"
                     class="mb-4" />

                <h4>

                    No Advisories Found

                </h4>

                <p class="text-muted">

                    Try adjusting your search filters.

                </p>

            </div>

        </div>
    }

</div>

